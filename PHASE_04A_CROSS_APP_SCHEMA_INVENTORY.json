  "economicContractValidation": {
    "absoluteInvariantRemoveAdsOnly": {
      "status": "PASS",
      "evidence": "Models.kt lines 12-14, 241-249. SubscriptionState.isAdFree returns true for ACTIVE_PRO and ACTIVE_PRO_LITE. No coupling exists to allowedQuality or downloadLimit."
    },
    "qualityGatingForbidden": {
      "status": "PASS",
      "evidence": "allowedQuality and downloadLimit are classified as independent technical permissions on /users/{uid} and protected from user modification in modifyingSensitiveUserFields(). Admin updateSubscription() strictly avoids touching quality."
    },
    "dualWriteReconciliation": {
      "status": "PASS",
      "canonicalFields": [
