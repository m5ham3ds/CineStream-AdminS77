    "pointsLedgerImmutability": {
      "status": "PASS",
      "evidence": "firestore.rules lines 148-152 restrict writes to /users/{uid}/point_transactions/{txId} strictly to isAdmin(). Wildcard subcollections write excludes point_transactions."
